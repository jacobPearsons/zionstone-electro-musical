# Base URL of the Express API service (`zionstone-api`), which owns the upload
# queue, Paystack checkout and shipping. Local dev points at the API dev server;
# production uses the Render URL, e.g. https://zionstone-api.onrender.com
NEXT_PUBLIC_API_URL=http://localhost:4000

# Clerk — auth for /dashboard. The publishable key is client-visible; the secret
# key is server-only and must never be committed.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
