# ─────────────────────────────────────────────────────────────────────────────
# Zionstone API — environment variables
#
# Copy to `.env` for local development. `.env` is gitignored and must never be
# committed. No real secrets belong in this file — placeholders only.
#
# Render + Neon provisioning notes:
#   * Neon gives you TWO connection strings for the same database:
#       - a pooled URL   (host contains `-pooler`)   → ideal for the app runtime
#       - a direct URL   (host without `-pooler`)    → required for migrations
#   * Prisma migrations must run over the DIRECT (non-pooled) URL. Set:
#       DATABASE_URL   = pooled URL   (app runtime traffic)
#       DIRECT_URL     = direct URL   (used by `prisma migrate deploy` at boot;
#                                       see render.yaml startCommand)
#     If you only have one URL, set DATABASE_URL to it and leave DIRECT_URL blank;
#     migrations will then run over DATABASE_URL.
#   * PGbouncer/Neon pooled connections do not support every session feature. If
#     you see `channel_binding` or prepared-statement errors, append
#     `?pgbouncer=true&connection_limit=1` to the pooled DATABASE_URL, or point
#     DATABASE_URL at the direct URL instead.
# ─────────────────────────────────────────────────────────────────────────────

# Runtime mode. `production` enables fail-closed CORS, disables permissive dev
# behavior, and is set automatically by Render at runtime (no need to set it
# there). Never set it to production for local development.
NODE_ENV="development"

# Prisma connection string used by the running app. With Neon, use the POOLED
# URL here. Falls back to DATABASE_URL_POOLED when DATABASE_URL is unset
# (see src/server.ts). Local dev default is the project-local cluster.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/zionstone"

# Direct (non-pooled) connection string, used only by `prisma migrate deploy`
# at startup. With Neon this is the same database as DATABASE_URL but without
# the `-pooler` host suffix. Optional — leave blank to migrate over DATABASE_URL.
DIRECT_URL=""

# Pooled connection string. Optional; alternative fallback for DATABASE_URL.
DATABASE_URL_POOLED=""

# HTTP port the Express server listens on. Render injects PORT automatically.
PORT=4000

# Absolute public base URL of THIS API. Used to build renderable image URLs:
# `${PUBLIC_API_URL}/uploads/<filename>`.
PUBLIC_API_URL="http://localhost:4000"

# Public base URL of the storefront. Informational only (e.g. for links shown in
# logs/emails); it does not gate traffic.
PUBLIC_SITE_URL="http://localhost:3000"

# Clerk secret key (server-side) — verifies admin Bearer tokens on the queue
# admin routes. Obtain from the Clerk dashboard. Never expose this to a client.
CLERK_SECRET_KEY="sk_test_placeholder"

# Paystack (Nigerian payment gateway) server-only secret key. Without it,
# POST /api/paystack/initialize returns 503.
PAYSTACK_SECRET_KEY="sk_test_placeholder"

# Comma-separated list of allowed browser origins for CORS (the storefront).
# Example: "https://zionstone.example.com,https://www.zionstone.example.com"
# In production this MUST be set — with it blank the API denies browser origins.
# Leave blank in local dev to allow any origin.
CLIENT_ORIGIN=""

# Directory for uploaded product photos. Served statically at /uploads/<file>.
# On Render, mount a persistent disk and point this at it (e.g. /var/data/uploads);
# the container filesystem is otherwise ephemeral and uploads vanish on deploy.
UPLOAD_DIR="uploads"

# Minimum log level: debug | info | warn | error. Defaults to info.
LOG_LEVEL="info"
